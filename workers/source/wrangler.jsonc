{
  "name": "bye-sources-local",
  "main": "index.ts",
  "compatibility_date": "2025-10-11",
  "workers_dev": false,
  "durable_objects": { "bindings": [{ "name": "SOURCES", "class_name": "Sources" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sources"] }],
  "vars": { "LIVE_APP_ENABLED": "false", "RMP_AUTHORIZED": "false", "RMP_CACHE_SECONDS": "0" },
  "env": {
    "preview": {
      "name": "bye-sources-preview",
      "durable_objects": { "bindings": [{ "name": "SOURCES", "class_name": "Sources" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sources"] }],
      "vars": { "LIVE_APP_ENABLED": "true", "RMP_AUTHORIZED": "false", "RMP_PERMISSION_REF": "owner-decision-2026-10-16-no-RMP-permission", "RMP_CACHE_SECONDS": "86400" }
    },
    "production": {
      "name": "bye-sources-production",
      "durable_objects": { "bindings": [{ "name": "SOURCES", "class_name": "Sources" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sources"] }],
      "vars": { "LIVE_APP_ENABLED": "true", "RMP_AUTHORIZED": "true", "RMP_PERMISSION_REF": "owner-decision-2026-10-16-no-RMP-permission", "RMP_CACHE_SECONDS": "86400" }
    }
  }
}
