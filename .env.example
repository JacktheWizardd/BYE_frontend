# Public config is still supplied to Pages, not compiled into browser assets.
# For local Pages dev, copy these fields into ignored .dev.vars.
REVIEWS_ENABLED=false
LIVE_APP_ENABLED=false
REVIEW_TEST_EMAIL=your-address@go.pasadena.edu
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional Turnstile bot check before code emails; off unless both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only honored on loopback HTTP. Leave unset in deployed previews.
REVIEW_LOCAL_HTTP=true
# Private review verification (server-only; leave blank until approved schema/backfill/cutover).
REVIEW_IDENTITY_SECRET=
REVIEW_DATABASE_URL=
BREVO_API_KEY=
REVIEW_SENDER_EMAIL=
# Operator credentials are supplied only when explicitly running reviews:admin, never to Pages.
# REVIEW_MIGRATION_DATABASE_URL is deliberately not loaded by the preview server.
